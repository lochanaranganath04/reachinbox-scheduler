PORT=4000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000

DATABASE_URL=postgres://reachinbox:reachinbox@localhost:5432/reachinbox
REDIS_URL=redis://localhost:6379
ELASTIC_NODE=http://localhost:9200

JWT_SECRET=change-me-to-a-long-random-string

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Slack requires an HTTPS redirect URL: use ngrok / cloudflared
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=https://YOUR-TUNNEL/auth/slack/callback

# Throughput
WORKER_CONCURRENCY=5
MIN_DELAY_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
MAX_ATTEMPTS=3

# Senders (auto-created Ethereal accounts, or provide your own as user:pass,user:pass)
SENDER_COUNT=3
ETHEREAL_ACCOUNTS=

RUN_WORKER=true
BULL_BOARD_USER=
BULL_BOARD_PASS=
